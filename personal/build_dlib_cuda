#!/bin/bash
# Builds dlib from source with CUDA support and installs it into the face_rec venv.
# Run this once whenever you need to upgrade dlib or after a CUDA change.

set -e

DLIB_VERSION="20.0.0"
VENV=~/.venvs/face_rec
CUDA_ROOT=/usr/local/cuda
BUILD_DIR=/tmp/dlib_cuda_build

echo "==> Installing build dependencies..."
"$VENV/bin/pip" install wheel setuptools

echo "==> Uninstalling existing dlib..."
"$VENV/bin/pip" uninstall dlib -y || true

echo "==> Downloading dlib $DLIB_VERSION source..."
rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
"$VENV/bin/pip" download "dlib==$DLIB_VERSION" --no-binary dlib --no-deps -d "$BUILD_DIR"
tar -xf "$BUILD_DIR/dlib-${DLIB_VERSION}.tar.gz" -C "$BUILD_DIR"
cd "$BUILD_DIR/dlib-${DLIB_VERSION}"

echo "==> Building wheel with CUDA enabled..."
"$VENV/bin/python3" setup.py bdist_wheel \
    --set DLIB_USE_CUDA=ON \
    --set CUDA_TOOLKIT_ROOT_DIR="$CUDA_ROOT" \
    --set CUDA_HOST_COMPILER=/usr/bin/gcc-12

echo "==> Installing wheel..."
"$VENV/bin/pip" install dist/*.whl

echo "==> Verifying CUDA support..."
"$VENV/bin/python3" -c "import dlib; print('DLIB_USE_CUDA:', dlib.DLIB_USE_CUDA)"

echo "==> Cleaning up..."
rm -rf "$BUILD_DIR"

echo "Done."
